<div
  id="mesh-logo"
  class="w-48 h-16 sm:w-32 sm:h-10 md:w-64 md:h-20 fixed top-0 mt-2 ml-1 z-40 pointer-events-none transition-[left] duration-500 ease-out"
  style="left: var(--logo-x, 16px);"
>
</div>
<script>
  import p5 from "p5";
  import { gsap } from "gsap";

  new p5((p: p5) => {
    let parent: HTMLElement | null = null;

    p.setup = (): void => {
      p.frameRate(60);
      parent = document.getElementById("mesh-logo");
      if (!parent) return;

      const canvas = p.createCanvas(parent.offsetWidth, parent.offsetHeight);
      canvas.parent(parent);
    };

    p.draw = (): void => {
      const containerWidth = p.width;
      const containerHeight = p.height;

      // 1. Reset blend mode to standard to cleanly clear the canvas frame
      p.blendMode(p.BLEND);

      // FIXED: Swapped background(0) for clear() to enable full HTML transparency
      p.clear();

      // --- MOVEMENT MATH ---
      let t1 = p.frameCount * 0.02;
      let t2 = p.frameCount * 0.015;

      const driftRange = containerHeight * 0.18;
      let baseRadius = containerHeight * 0.35;

      let x1 = p.cos(t1) * driftRange;
      let y1 = p.sin(t1 * 1.3) * driftRange;

      let x2 = p.cos(t2 + p.PI) * driftRange;
      let y2 = p.sin(t2 * 0.9) * driftRange;

      // --- PULSATING SIZE EFFECT ---
      let pulse1 = 1.0 + 0.3 * p.sin(p.frameCount * 0.02);
      let pulse2 = 1.0 + 0.3 * p.sin(p.frameCount * 0.02 + p.PI);

      let radius1 = baseRadius * pulse1;
      let radius2 = baseRadius * pulse2;

      // 2. Turn on exclusion blending for the overlapping inversion
      p.blendMode(p.EXCLUSION);

      p.fill("#F0F0F0");

      // --- LEFT EYES ---
      const leftEyeX = containerWidth * 0.15;
      const eyeY = containerHeight * 0.5;
      
      p.circle(leftEyeX + x1, eyeY + y1, radius1);
      p.circle(leftEyeX + x2, eyeY + y2, radius2);

      // --- MOUTH (CENTER) - TWO SINE WAVES ---
      const mouthX = containerWidth * 0.5;
      const mouthY = containerHeight * 0.5;
      const mouthWidth = containerHeight * 0.25;

      // Animating amplitudes and maximums
      let amp1 = containerHeight * 0.12 * (1.0 + 0.4 * p.sin(p.frameCount * 0.015));
      let amp2 = containerHeight * 0.15 * (1.0 + 0.3 * p.sin(p.frameCount * 0.015 + p.PI / 3));
      
      let max1 = containerHeight * 0.08 * (1.0 + 0.5 * p.sin(p.frameCount * 0.012));
      let max2 = containerHeight * 0.1 * (1.0 + 0.4 * p.sin(p.frameCount * 0.012 + p.PI / 2));

      p.noFill();
      p.strokeWeight(2);
      p.stroke("#F0F0F0");

      // Draw first sine wave
      p.beginShape();
      for (let i = 0; i <= 1; i += 0.05) {
        const x = mouthX - mouthWidth / 2 + i * mouthWidth;
        const y = mouthY + max1 + p.sin(i * p.PI) * amp1;
        p.vertex(x, y);
      }
      p.endShape();

      // Draw second sine wave (offset phase)
      p.beginShape();
      for (let i = 0; i <= 1; i += 0.05) {
        const x = mouthX - mouthWidth / 2 + i * mouthWidth;
        const y = mouthY + max2 + p.sin(i * p.PI + p.PI / 4) * amp2;
        p.vertex(x, y);
      }
      p.endShape();

      // --- RIGHT EYES (mirrored) ---
      const rightEyeX = containerWidth * 0.85;
      
      p.noStroke();
      p.fill("#F0F0F0");
      p.circle(rightEyeX - x1, eyeY + y1, radius1);
      p.circle(rightEyeX - x2, eyeY + y2, radius2);
    };

    p.windowResized = (): void => {
      if (!parent) return;
      p.resizeCanvas(parent.offsetWidth, parent.offsetHeight);
    };
  });

  function initLogoScroll() {
    const meshLogo = document.getElementById("mesh-logo");
    if (!meshLogo) return;

    let lastScroll = window.scrollY;
    let isHidden = false;

    window.addEventListener("scroll", () => {
      const currentScroll = window.scrollY;

      if (currentScroll > lastScroll && currentScroll > 50) {
        if (!isHidden) {
          isHidden = true;

          gsap.to(meshLogo, {
            x: -180,
            y: -180,
            duration: 0.5,
            ease: "power3.inOut",
          });
        }
      } else {
        if (isHidden) {
          isHidden = false;

          gsap.to(meshLogo, {
            x: 0,
            y: 0,
            duration: 0.6,
            ease: "power4.out",
          });
        }
      }

      lastScroll = currentScroll;
    });
  }

  initLogoScroll();
  document.addEventListener("astro:page-load", () => {
    initLogoScroll();
  });
</script>
