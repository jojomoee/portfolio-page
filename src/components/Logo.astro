<div
  id="mesh-logo"
  class="w-16 h-16 sm:w-10 sm:h-10 md:w-20 md:h-20 fixed top-0 mt-2 ml-1 z-40 pointer-events-none transition-[left] duration-500 ease-out"
  style="left: var(--logo-x, 16px);"
>
</div>
<script>
  import p5 from "p5";
  import { gsap } from "gsap";

  new p5((p: p5) => {
    let parent: HTMLElement | null = null;

    p.setup = (): void => {
      p.frameRate(60);
      parent = document.getElementById("mesh-logo");
      if (!parent) return;

      const canvas = p.createCanvas(parent.offsetWidth, parent.offsetHeight);
      canvas.parent(parent);
    };

    p.draw = (): void => {
      const containerSize = p.width;

      // 1. Reset blend mode to standard to cleanly clear the canvas frame
      p.blendMode(p.BLEND);

      // FIXED: Swapped background(0) for clear() to enable full HTML transparency
      p.clear();

      p.translate(p.width / 2, p.height / 2);

      // --- MOVEMENT MATH ---
      let t1 = p.frameCount * 0.02;
      let t2 = p.frameCount * 0.015;

      const driftRange = containerSize * 0.18;
      let baseRadius = containerSize * 0.48;

      let x1 = p.cos(t1) * driftRange;
      let y1 = p.sin(t1 * 1.3) * driftRange;

      let x2 = p.cos(t2 + p.PI) * driftRange;
      let y2 = p.sin(t2 * 0.9) * driftRange;

      // --- PULSATING SIZE EFFECT ---
      // Slower pulsation (0.02 instead of 0.05) and bigger range (0.6 to 1.4)
      let pulse1 = 1.0 + 0.4 * p.sin(p.frameCount * 0.02);
      let pulse2 = 1.0 + 0.4 * p.sin(p.frameCount * 0.02 + p.PI);

      let radius1 = baseRadius * pulse1;
      let radius2 = baseRadius * pulse2;

      // 2. Turn on exclusion blending for the overlapping inversion
      p.blendMode(p.EXCLUSION);

      p.fill("#F0F0F0");

      // Draw shapes
      p.circle(x1, y1, radius1);
      p.circle(x2, y2, radius2);
    };

    p.windowResized = (): void => {
      if (!parent) return;
      p.resizeCanvas(parent.offsetWidth, parent.offsetHeight);
    };
  });

  function initLogoScroll() {
    const meshLogo = document.getElementById("mesh-logo");
    if (!meshLogo) return;

    let lastScroll = window.scrollY;
    let isHidden = false;

    window.addEventListener("scroll", () => {
      const currentScroll = window.scrollY;

      if (currentScroll > lastScroll && currentScroll > 50) {
        if (!isHidden) {
          isHidden = true;

          gsap.to(meshLogo, {
            x: -180,
            y: -180,
            duration: 0.5,
            ease: "power3.inOut",
          });
        }
      } else {
        if (isHidden) {
          isHidden = false;

          gsap.to(meshLogo, {
            x: 0,
            y: 0,
            duration: 0.6,
            ease: "power4.out",
          });
        }
      }

      lastScroll = currentScroll;
    });
  }

  initLogoScroll();
  document.addEventListener("astro:page-load", () => {
    initLogoScroll();
  });
</script>
