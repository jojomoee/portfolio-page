<Menu />
<style>
  .morph {
    display: none !important;
  }
</style>

<script>
  import gsap from "gsap";
  import { MorphSVGPlugin } from "gsap/MorphSVGPlugin";
  gsap.registerPlugin(MorphSVGPlugin);

  // 2. This event fires on the first load AND every time you navigate back/forward
  document.addEventListener("astro:page-load", () => {
    // Clear any lingering animations on these elements to be perfectly safe
    gsap.killTweensOf(".base");

    // Start your morph cycle
    gsap.utils.toArray(".shape-group").forEach((group) => {
      const baseElement = group.querySelector(".base");
      const morphElement = group.querySelector(".morph");

      if (baseElement && morphElement) {
        gsap.to(baseElement, {
          morphSVG: morphElement,
          duration: 5,
          ease: "power2.inOut",
          repeat: -1,
          yoyo: true,
        });
      }
    });
  });
</script>
