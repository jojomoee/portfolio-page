---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Menu from "../components/Menu.astro";
const gridItems = [
  {
    id: 1,
    text: "PROJECT ONE",
    desc: "24x12 cm marker",
    slug: "project-one",
    imgSrc:
      "https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?w=600&h=900&fit=crop",
  },
  {
    id: 2,
    text: "PROJECT TWO",
    desc: "24x12 cm marker ",
    slug: "project-two",
    imgSrc:
      "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=900&h=600&fit=crop",
  },
  {
    id: 3,
    text: "PROJECT THREE",
    desc: "24x12 cm other",
    slug: "project-three",
    imgSrc:
      "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&h=800&fit=crop",
  },
  {
    id: 4,
    text: "PROJECT FOUR",
    desc: "Classic Landscape Painting",
    slug: "project-four",
    imgSrc:
      "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=1200&h=500&fit=crop",
  },
];
---

<Layout>
  <Header />

  <div class="flex justify-center items-center w-full px-6">
    <div
      id="portfolio-grid"
      class="grid grid-cols-1 md:grid-cols-2 gap-5 w-full max-w-8xl text-white"
    >
      {
        gridItems.map((item) => {
          return (
            /* Changed outer `div` to an `a` tag and added dynamic href */
            <a
              href={`/details/${item.slug}`}
              class="portfolio-item block w-full aspect-square border border-white/20 flex flex-col overflow-hidden bg-black transition-all duration-300 hover:border-white/50"
            >
              <div class="flex-1 w-full flex items-center justify-center overflow-hidden bg-neutral-950/40">
                <img
                  src={item.imgSrc}
                  alt={item.text}
                  class="max-w-full max-h-full object-contain transition-transform duration-500 hover:scale-[1.02]"
                />
              </div>

              <div class="w-full bg-black px-2 pb-2 shrink-0">
                <h3 class="tracking-wide uppercase">{item.text}</h3>
                <p class="text-xs text-neutral-400 mt-0.5 font-mono tracking-tight">
                  {item.desc}
                </p>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</Layout>
